# Kopieren nach .env und anpassen.

# Geheimnis für Anmeldungen. Leer lassen: Der Server erzeugt beim ersten Start selbst eines
# (data/geheimnis.txt). Nur setzen, wenn es von außen vorgegeben werden soll.
# JWT_SECRET=

# Wie lange eine Anmeldung gültig bleibt (Tage)
JWT_EXPIRE_DAYS=30

# Ablage für Datenbank, Upload-Teile, Hörproben
DATA_DIR=./data

# Erlaubte Herkünfte für CORS (Komma-getrennt).
# Browser-Entwicklung: http://localhost:5173, Android-App (androidScheme http): http://localhost
# Nach Umstellung der App auf HTTPS: https://localhost ergänzen/ersetzen.
CORS_ORIGINS=http://localhost:5173,http://localhost

# Öffentliche Angaben des Servers (erscheinen in der App beim Verbinden)
SERVER_NAME=Session-Chronik
SERVER_OPERATOR=Rollenspielverein
# SERVER_CONTACT=vorstand@example.org
# PRIVACY_POLICY_URL=https://example.org/datenschutz
MIN_AGE=16

# Name der Organisation (Verein), die beim ersten Start angelegt wird
ORGANIZATION_NAME=Rollenspielverein

# Gültigkeit von Einladungscodes (Tage)
INVITE_TTL_DAYS=7

# Hinter Cloudflare Tunnel / Tailscale später auf die Proxy-Adresse setzen, z. B. 127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# Hugging Face Zugangsschlüssel für die Sprechertrennung (beginnt mit hf_), siehe INSTALLATION.md Teil 5
HF_TOKEN=

# --- Aufnahmen und Warteschlange (Schritt 2) – Standardwerte passen meist ---
# AUDIO_RETENTION_DAYS=7        # Audio fehlgeschlagener Verarbeitungen spätestens danach löschen
# UPLOAD_ABANDON_DAYS=7         # nie abgeschlossene Uploads danach verwerfen
# MAX_FILE_BYTES=2147483648     # größte erlaubte Datei (2 GiB)

# --- Worker (nur auf dem lokalen Server, der Aufnahmen verarbeitet) ---
# Schlüssel anlegen: uv run chronik worker-token create --name heim-pc
# WORKER_TOKEN=wk....
# WORKER_SERVER_URL=http://127.0.0.1:8000

# --- Zusammenfassung (Recap und Bibel-Vorschläge) ---
# Zusammenfassung – normalerweise in der Verwaltung unter „Zusammenfassung“ eingestellt (hat dann Vorrang):
# SUMMARIZER=attrappe           # aus | attrappe | lokal (Worker mit Ollama) | api
# LLM_API_MODEL=mistral-large-latest
# LLM_API_KEY=...               # leer: bei Mistral gilt MISTRAL_API_KEY bzw. der Schlüssel aus der Verwaltung
# LLM_LOCAL_MODEL=ministral-3:8b
# Nur für den Worker: wo Ollama läuft
# WORKER_LLM_URL=http://localhost:11434

# --- Transkription im Worker (Schritt 3) ---
# WHISPER_MODEL=large-v3
# WHISPER_COMPUTE_TYPE=int8_float16
# WHISPER_BATCH=8               # bei „Grafikspeicher voll“: 4

# --- Externe Transkription als Ersatz (optional, Standard aus) ---
# Audio verlässt dann den eigenen Betrieb: Vertrag zur Auftragsverarbeitung + Datenschutzhinweis nötig.
# EXTERNAL_TRANSCRIPTION=mistral
# MISTRAL_API_KEY=...
# EXTERNAL_AFTER_HOURS=24
