diff --git a/tests/test_step5.py b/tests/test_step5.py
index 352609a..11d4353 100644
--- a/tests/test_step5.py
+++ b/tests/test_step5.py
@@ -368,2 +368,68 @@ def test_recap_probe_speichert_nichts(client, world, dbs, tmp_path, api):
