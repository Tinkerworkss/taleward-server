+    def kuerzen(self, ein: dict, punkte: list[dict], r: dict, befund: list[dict]) -> list[dict] | None:
+        """0.4.68: Kapitel weit über der Längenvorgabe kürzen. Übernommen nur, wenn alle bisher erzählten Pflichtpunkte
