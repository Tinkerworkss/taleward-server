+
+
+def absaetze(text: str) -> list[str]:
+    """Absätze eines Recaps (durch Leerzeile getrennt) – wie die App sie zählt."""
+    return [a.strip() for a in re.split(r"\n\s*\n", text.strip()) if a.strip()]
