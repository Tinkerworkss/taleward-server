+    for f in befund:
+        if f.get("status") != "widerspricht" or f.get("absatz") is None or not (0 <= f["absatz"] < anzahl):
+            continue
+        b = absaetze_.get(f["absatz"])
+        if b is None:
+            continue
+        if not (b.get("verdict") == "contradicted" and b.get("note")):
+            b["note"] = f["begruendung"] or None
+        b["verdict"] = "contradicted"
+
