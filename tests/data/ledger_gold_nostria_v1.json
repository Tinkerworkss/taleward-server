        "assertions": [
          {
            "subject": ["Kano", "Kano Tommeldom"],
            "property": "life_status",
            "value": ["dead", "tot", "verstorben"]
          }
        ]
      },
      "expected": {"epistemic": ["observed"], "relevance": {"recap": true, "bible": true}}
    },
    {
      "id": "orasilas_rescues_arlekin",
      "description": "Orasilas rettet Arlekin im Wasser/Tommel.",
