     db.commit()
     d, k = DIENSTE[dienst], konfig(db, dienst)
@@ -149,5 +164,5 @@ def start(db: Session, dienst: str, challenge: str, purpose: str, link_token: st
     if d["art"] == "oidc":
         werte["nonce"] = nonce
-    return f"{d['auth']}?{urlencode(werte)}"
