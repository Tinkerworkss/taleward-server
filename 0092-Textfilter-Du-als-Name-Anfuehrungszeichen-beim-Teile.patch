+_SATZENDE = re.compile(r"(?:(?<=[.!?…])|(?<=[.!?…][»«“\"')])|(?<=[.!?…][»«“\"')]{2}))\s+(?=[„\"»«(]?[A-ZÄÖÜ0-9])")
 
 
