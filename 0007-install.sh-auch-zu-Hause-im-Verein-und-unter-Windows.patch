-  ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null; ufw allow 443/udp >/dev/null
-  echo "Firewall: Ports 80 und 443 freigegeben."
+  for p in $PORTS; do ufw allow "$p/tcp" >/dev/null; done
