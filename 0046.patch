          "proposals": pruefen(roh, {e["id"] for e in ein["bibel"]}, {e["id"] for e in ein["geheim"]},
-                              charaktere=[p["charakter"] for p in ein["personen"] if p.get("charakter")])}
+                              charaktere=[p["charakter"] for p in ein["personen"] if p.get("charakter")],
+                              namen={e["id"]: e["name"] for e in ein["bibel"] + ein["geheim"]})}
